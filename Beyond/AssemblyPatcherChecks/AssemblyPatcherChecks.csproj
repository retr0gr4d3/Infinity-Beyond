<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Launcher\AssemblyPatcher.cs" Link="AssemblyPatcher.cs" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <!-- A clean install has no BeyondAgent.dll in Managed; the runner falls
         back to the build's copy placed beside it. -->
    <None Include="..\build\BeyondAgent.dll" Link="BeyondAgent.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\build\BeyondAgent.dll')" />
  </ItemGroup>
</Project>
